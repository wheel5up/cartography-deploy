# SAM custom build (BuildMethod: makefile) for the OktaLoaderFunction.
#
# Same two-part strategy as ../lambda-loader/Makefile: pip-install a trimmed
# dependency set, then vendor the pinned `cartography/` package SOURCE TREE
# from the wheel5up fork alongside it. `pip install cartography` is
# deliberately NOT used — see requirements.txt's header comment.
#
# Okta needs no fork-specific patches; vendoring from the fork keeps every
# loader on a pinned commit. Upstream adds Okta features often (devices,
# policies, network zones, API tokens, log streams), so validate a full sync
# against a non-production graph before moving this ref.
#
# `sam build` invokes this target with:
#   ARTIFACTS_DIR = the directory SAM expects the final Lambda package in
#
# CARTOGRAPHY_GIT_REF selects which tag/branch of the fork to vendor.
CARTOGRAPHY_GIT_REF ?= v0.0.1rc18
CARTOGRAPHY_FORK_URL ?= https://github.com/wheel5up/cartography.git

build-OktaLoaderFunction:
	mkdir -p "$(ARTIFACTS_DIR)"

	# 1. Handler code
	cp src/handler.py "$(ARTIFACTS_DIR)/"

	# 2. Trimmed runtime dependencies (NOT `pip install cartography` — see
	#    requirements.txt header)
	pip install -r requirements.txt --target "$(ARTIFACTS_DIR)" --no-cache-dir

	# 3. Vendor cartography's source tree at the pinned tag. Shallow clone
	#    to a scratch dir, copy just the `cartography/` package dir in its
	#    entirety (NOT just intel/okta + models/okta — cartography.intel.okta
	#    transitively imports cartography.util, cartography.client.core.tx,
	#    cartography.graph.*, cartography.stats, cartography.models.core.*,
	#    cartography.config, cartography.sync, and cartography.data.jobs.cleanup's
	#    JSON files via importlib.resources — a hand-picked subset breaks on
	#    the next transitive import discovered. The whole package dir is
	#    only ~17MB uncompressed; cheaper to vendor it all than to maintain
	#    a brittle allowlist of submodules).
	rm -rf /tmp/cartography-vendor-src-okta
	git clone --depth 1 --branch "$(CARTOGRAPHY_GIT_REF)" "$(CARTOGRAPHY_FORK_URL)" /tmp/cartography-vendor-src-okta
	cp -r /tmp/cartography-vendor-src-okta/cartography "$(ARTIFACTS_DIR)/cartography"
	rm -rf /tmp/cartography-vendor-src-okta
	find "$(ARTIFACTS_DIR)/cartography" -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
	find "$(ARTIFACTS_DIR)/cartography" -name "*.dist-info" -type d -exec rm -rf {} + 2>/dev/null || true

	# 4. cartography/_version.py is normally generated by setuptools-scm from
	#    the git tag at install time. A raw git clone has no such step.
	#    Nothing in the sync path this handler calls reads __version__, but
	#    stub the full set of names cartography/version.py imports so any
	#    incidental import doesn't ImportError — same as
	#    ../lambda-loader/Makefile.
	printf '%s\n' \
	  "__version__ = version = '$(CARTOGRAPHY_GIT_REF)-lambda-vendored'" \
	  "__version_tuple__ = version_tuple = (0, 0, 0, 'lambda-vendored')" \
	  "__commit_id__ = commit_id = None" \
	  > "$(ARTIFACTS_DIR)/cartography/_version.py"
