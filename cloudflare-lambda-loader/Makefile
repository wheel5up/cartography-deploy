# SAM custom build (BuildMethod: makefile) for the CloudflareLoaderFunction.
#
# Same two-part strategy as ../okta-lambda-loader/Makefile,
# ../vercel-lambda-loader/Makefile, and ../lambda-loader/Makefile: pip-install
# a trimmed dependency set, then vendor the pinned `cartography/` package
# SOURCE TREE from the wheel5up fork alongside it. `pip install cartography`
# is deliberately NOT used — see requirements.txt's header comment.
#
# Vendoring from the FORK url (not cartography-cncf directly) so this Lambda
# tracks the exact same pinned commit the other Lambda loaders do — one
# source of truth for "what version of cartography is deployed".
#
# The cloudflare SDK is pinned in requirements.txt (cloudflare==5.7.0), not
# by the fork: the fork's pyproject.toml has cloudflare>=4.1.0.
# cloudflare-python 5.8.0 renamed r2.buckets' `jurisdiction` kwarg to
# `cf_r2_jurisdiction`, which crashes the R2 sync.
#
# `sam build` invokes this target with:
#   ARTIFACTS_DIR = the directory SAM expects the final Lambda package in
CARTOGRAPHY_GIT_REF ?= v0.0.1rc18
CARTOGRAPHY_FORK_URL ?= https://github.com/wheel5up/cartography.git

build-CloudflareLoaderFunction:
	mkdir -p "$(ARTIFACTS_DIR)"

	# 1. Handler code
	cp src/handler.py "$(ARTIFACTS_DIR)/"

	# 2. Trimmed, EXACTLY-PINNED runtime dependencies (NOT `pip install
	#    cartography` — see requirements.txt header, and NOT >= floating
	#    minimums like every other loader's requirements.txt uses — see
	#    requirements.txt's own comment on why this one is an exception).
	pip install -r requirements.txt --target "$(ARTIFACTS_DIR)" --no-cache-dir

	# 3. Vendor cartography's source tree at the pinned tag. Shallow clone
	#    to a scratch dir, copy just the `cartography/` package dir in its
	#    entirety (NOT just intel/cloudflare + models/cloudflare —
	#    cartography.intel.cloudflare transitively imports cartography.util,
	#    cartography.client.core.tx, cartography.graph.*, cartography.stats,
	#    cartography.models.core.*, cartography.config, cartography.sync —
	#    a hand-picked subset breaks on the next transitive import
	#    discovered, same lesson ../okta-lambda-loader/Makefile and
	#    ../vercel-lambda-loader/Makefile document. The whole package dir is
	#    only ~17MB uncompressed; cheaper to vendor it all than to maintain
	#    a brittle allowlist of submodules).
	rm -rf /tmp/cartography-vendor-src-cloudflare
	git clone --depth 1 --branch "$(CARTOGRAPHY_GIT_REF)" "$(CARTOGRAPHY_FORK_URL)" /tmp/cartography-vendor-src-cloudflare
	cp -r /tmp/cartography-vendor-src-cloudflare/cartography "$(ARTIFACTS_DIR)/cartography"
	rm -rf /tmp/cartography-vendor-src-cloudflare
	find "$(ARTIFACTS_DIR)/cartography" -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
	find "$(ARTIFACTS_DIR)/cartography" -name "*.dist-info" -type d -exec rm -rf {} + 2>/dev/null || true

	# 4. cartography/_version.py is normally generated by setuptools-scm from
	#    the git tag at install time. A raw git clone has no such step.
	#    Nothing in the sync path this handler calls reads __version__, but
	#    stub the full set of names cartography/version.py imports so any
	#    incidental import doesn't ImportError — same as
	#    ../okta-lambda-loader/Makefile and ../vercel-lambda-loader/Makefile.
	printf '%s\n' \
	  "__version__ = version = '$(CARTOGRAPHY_GIT_REF)-lambda-vendored'" \
	  "__version_tuple__ = version_tuple = (0, 0, 0, 'lambda-vendored')" \
	  "__commit_id__ = commit_id = None" \
	  > "$(ARTIFACTS_DIR)/cartography/_version.py"
