# SAM custom build (BuildMethod: makefile) for the CartographyLoaderFunction.
#
# Why a Makefile instead of `BuildMethod: python3.13` (SAM's default, which
# just pip-installs requirements.txt next to the handler):
#
#   We need one extra step: vendor the pinned `cartography/` package
#   SOURCE TREE from the wheel5up fork into the build artifacts, alongside
#   the handler and the trimmed requirements.txt dependency set. `pip install
#   cartography` is deliberately NOT used here — see requirements.txt's
#   header comment for why (it would pull in the full azure/gcp/oci/k8s
#   provider dependency tree that this handler never imports).
#
# `sam build` invokes this target with:
#   ARTIFACTS_DIR = the directory SAM expects the final Lambda package in
#
# CARTOGRAPHY_GIT_REF selects which tag/branch of the fork to vendor.
#
# Requires rc28 or later: rc28 adds ssm:parameter to AWS_TAGGABLE_RESOURCES,
# so resourcegroupstaggingapi writes (:AWSSSMParameter)-[:TAGGED]->(:AWSTag)
# (see PERMISSIONS.md). Before moving this ref, diff cartography/intel/aws,
# models/aws, graph and client between the tags and validate a full AWS sync
# against a non-production graph.
CARTOGRAPHY_GIT_REF ?= v0.0.1rc28
CARTOGRAPHY_FORK_URL ?= https://github.com/wheel5up/cartography.git

build-CartographyLoaderFunction:
	mkdir -p "$(ARTIFACTS_DIR)"

	# 1. Handler code
	cp src/handler.py src/splits.py "$(ARTIFACTS_DIR)/"

	# 1b. Our AWS permission-relationships mapping (lands at
	#     /var/task/permission_relationships.yaml, next to handler.py). The
	#     vendored fork's cartography/data/ copy is deliberately NOT used, so a
	#     CARTOGRAPHY_GIT_REF bump can't silently change what CAN_* edges get
	#     built. See the file's header and README.md "Permission mapping".
	cp permission_relationships.yaml "$(ARTIFACTS_DIR)/"

	# 2. Trimmed runtime dependencies (NOT `pip install cartography` — see
	#    requirements.txt header)
	pip install -r requirements.txt --target "$(ARTIFACTS_DIR)" --no-cache-dir

	# 3. Vendor cartography's source tree at the pinned tag. Shallow clone to
	#    a scratch dir, copy just the `cartography/` package dir, discard the
	#    rest (tests/, docs/, .git/) to keep the artifact small.
	rm -rf /tmp/cartography-vendor-src
	git clone --depth 1 --branch "$(CARTOGRAPHY_GIT_REF)" "$(CARTOGRAPHY_FORK_URL)" /tmp/cartography-vendor-src
	cp -r /tmp/cartography-vendor-src/cartography "$(ARTIFACTS_DIR)/cartography"
	rm -rf /tmp/cartography-vendor-src
	find "$(ARTIFACTS_DIR)/cartography" -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
	find "$(ARTIFACTS_DIR)/cartography" -name "*.dist-info" -type d -exec rm -rf {} + 2>/dev/null || true

	# 4. cartography/_version.py is normally generated by setuptools-scm from
	#    the git tag at install time. A raw git clone has no such step. Nothing
	#    in the sync path this handler calls reads __version__, but stub the
	#    full set of names cartography/version.py imports (`version`,
	#    `__version_tuple__`, `commit_id`, etc.) so any incidental import
	#    (e.g. a future --version-style diagnostic) doesn't ImportError.
	printf '%s\n' \
	  "__version__ = version = '$(CARTOGRAPHY_GIT_REF)-lambda-vendored'" \
	  "__version_tuple__ = version_tuple = (0, 0, 0, 'lambda-vendored')" \
	  "__commit_id__ = commit_id = None" \
	  > "$(ARTIFACTS_DIR)/cartography/_version.py"

# --- account-splits: lint and store (see src/splits.py) -------------------
.PHONY: splits-check splits-put
splits-check:
	python3 src/splits.py account-splits.json

splits-put:
	scripts/put-account-splits.sh account-splits.json
